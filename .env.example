# Postgres connection string.
# Local dev: point at your own Postgres. On Render this is injected
# automatically from the database declared in render.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stacked?schema=public"

# Auth.js signing secret. Generate one with:
#   npx auth secret
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required when running behind Render's proxy so Auth.js trusts the host header.
AUTH_TRUST_HOST="true"
