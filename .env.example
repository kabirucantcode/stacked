# Postgres connection string.
# Local dev: point at your own Postgres. On Render this is injected
# automatically from the database declared in render.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stacked?schema=public"

# Auth.js signing secret. Generate one with:
#   npx auth secret
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required when running behind Render's proxy so Auth.js trusts the host header.
AUTH_TRUST_HOST="true"

# Absolute URL used to build links in emails. On Render this falls back to
# RENDER_EXTERNAL_URL automatically; set it explicitly for local dev if needed.
APP_URL="http://localhost:3000"

# --- Email (optional) ---------------------------------------------------
# Without RESEND_API_KEY, emails are logged to the server console instead of
# being sent, so verification and password reset are fully testable locally.
# Get a key at https://resend.com. EMAIL_FROM must be a domain you verified
# there; the default sender only delivers to your own account address.
RESEND_API_KEY=""
EMAIL_FROM="stacked <onboarding@resend.dev>"

# --- Security -----------------------------------------------------------
# Encrypts TOTP secrets at rest (AES-256-GCM, key derived via HKDF). Falls back
# to AUTH_SECRET when unset. Set it explicitly in production so that rotating
# AUTH_SECRET doesn't invalidate everyone's two-factor enrolment.
TOTP_ENCRYPTION_KEY=""

# --- Demo trading -------------------------------------------------------
# Simulated trades that move the balance so the dashboard has live data.
# Set DEMO_TRADING=false to freeze it.
DEMO_TRADING="true"
DEMO_TRADE_COOLDOWN_MS="6000"

# --- Crypto deposits (optional) -----------------------------------------
# Watch-only receiving addresses, pre-generated in your custody wallet,
# comma-separated. Each user is assigned one so a deposit can be attributed
# without a memo field. Scanning requires an Etherscan API key.
DEPOSIT_ADDRESSES=""
CRYPTO_CHAIN_ID="1"
CRYPTO_NATIVE_SYMBOL="ETH"
CRYPTO_ACCEPTED_TOKENS="USDC,USDT,DAI,ETH"
CRYPTO_MIN_CONFIRMATIONS="3"
# USD prices for non-stablecoins (stablecoins default to $1). A transfer whose
# price we don't know is recorded but never credited.
CRYPTO_USD_PRICES="ETH=3000"
ETHERSCAN_API_KEY=""
ETHERSCAN_API_URL="https://api.etherscan.io/v2/api"

# --- Scheduler ----------------------------------------------------------
# Shared secret for /api/cron/*. Without it those endpoints reject everything.
CRON_SECRET=""
