// Prisma schema for stacked.
//
// Money is stored in integer cents (`amountCents`) everywhere — never floats.
// Balances are NOT stored on Account; they are derived by summing ledger
// entries, so the ledger is the single source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Vibe {
  CHILL
  BALANCED
  FULL_SEND
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          String    @default("user")
  emailVerified DateTime?
  /// Bumped whenever the password changes so existing JWTs can be rejected.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account     Account?
  riskProfile RiskProfile?
  tokens      Token[]
  depositAddress DepositAddress?

  @@index([createdAt])
}

model Account {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vibe      Vibe          @default(BALANCED)
  status    AccountStatus @default(ACTIVE)
  currency  String        @default("USD")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  entries        LedgerEntry[]
  cryptoDeposits CryptoDeposit[]
  demoTrades     DemoTrade[]
}

/// Append-only record of everything that moves money.
/// Signed: credits are positive, debits are negative.
model LedgerEntry {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LedgerType
  amountCents Int
  label       String
  note        String?
  createdAt   DateTime   @default(now())

  @@index([accountId, createdAt])
}

/// The audit trail for the risk acknowledgement shown during onboarding.
/// Compliance needs the disclosure version and the timestamp, not just a checkbox.
model RiskProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vibe              Vibe
  disclosureVersion String
  acknowledgedAt    DateTime
  createdAt         DateTime @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  vibe      Vibe?
  amount    Int?
  createdAt DateTime @default(now())
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens emailed to the user. Only the SHA-256 hash is stored, so a
/// database leak does not hand out working reset links.
model Token {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TokenType
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
}

/// Idempotency guard for money-moving endpoints.
/// The unique constraint on (scope, key) is the lock: whichever request inserts
/// the row first performs the operation; everyone else replays the stored result.
model IdempotencyKey {
  id          String    @id @default(cuid())
  scope       String
  key         String
  status      Int?
  response    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([scope, key])
}

/// A receiving address users send crypto to. Addresses are pre-generated in a
/// custody wallet and assigned to at most one user, so attribution never relies
/// on a memo field (ERC-20 transfers don't have one).
model DepositAddress {
  id         String    @id @default(cuid())
  address    String    @unique
  chainId    Int       @default(1)
  label      String?
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  assignedAt DateTime?
}

/// One on-chain transfer detected for an account.
/// `@@unique([chainId, txHash, assetKey])` is the idempotency guard: the same
/// transfer can never be credited twice, no matter how often we re-scan.
model CryptoDeposit {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chainId       Int       @default(1)
  txHash        String
  /// "native" for ETH, otherwise the token contract address (lower-cased).
  assetKey      String
  fromAddress   String
  tokenSymbol   String
  decimals      Int
  /// Raw base units as a string, so uint256 values survive as BigInt.
  amountRaw     String
  amountCents   Int?
  confirmations Int       @default(0)
  creditedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([chainId, txHash, assetKey])
  @@index([accountId, createdAt])
}

/// A simulated trade. No broker, no order, no fill — see lib/demo-trading.ts.
model DemoTrade {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  side      String
  reason    String
  quantity  Float
  priceUsd  Float
  pnlCents  Int
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}
